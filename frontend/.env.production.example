# ===========================================
# SSB NextGen Pro Frontend - PRODUCTION Environment
# ===========================================
# Set these in the Vercel Dashboard → Settings → Environment Variables
# Do NOT commit real values to version control!

# ===========================================
# Supabase Configuration (Required)
# ===========================================
# These are PUBLIC keys — safe to expose in frontend
NEXT_PUBLIC_SUPABASE_URL=https://oexyteyhyefabiecizfw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ===========================================
# Backend API URLs (Required)
# ===========================================
# Backend-AI (Python/FastAPI) — deployed on Render free tier
NEXT_PUBLIC_API_URL=https://your-backend-ai.onrender.com/api/v1

# Backend-Core (Node.js) — deployed on Render free tier
NEXT_PUBLIC_BACKEND_CORE_URL=https://your-backend-core.onrender.com

# ===========================================
# Feature Flags
# ===========================================
NEXT_PUBLIC_ENABLE_AUTH=true
NEXT_PUBLIC_ENABLE_MATCHMAKING=false
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# ===========================================
# Analytics (Optional)
# ===========================================
# NEXT_PUBLIC_GA_ID=your-google-analytics-id
