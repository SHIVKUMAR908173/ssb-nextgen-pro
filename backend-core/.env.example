# ===========================================
# SSB NextGen Pro - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control!

# ===========================================
# Server Configuration
# ===========================================
PORT=3001
NODE_ENV=development

# ===========================================
# Supabase Configuration
# ===========================================
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Frontend Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ===========================================
# Redis Configuration
# ===========================================
REDIS_URL=redis://127.0.0.1:6379
ENABLE_REDIS_MATCHMAKING=false

# ===========================================
# Security Configuration
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
SESSION_SECRET=your-session-secret-key
CORS_ORIGIN=https://your-domain.com

# ===========================================
# Rate Limiting Configuration
# ===========================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
MAX_PAYLOAD_BYTES=200000

# ===========================================
# Matchmaking Configuration
# ===========================================
MATCHMAKING_NOTIFY_CHANNEL=gd-gpe:notify
MATCHMAKING_QUEUE_KEY=gd-gpe:queue
MATCHMAKING_GROUP_MIN_SIZE=8
MATCHMAKING_GROUP_MAX_SIZE=10
MATCHMAKING_TTL_MS=600000
MATCHMAKING_CANDIDATE_MAX_AGE_MS=600000

# ===========================================
# OpenTelemetry Configuration
# ===========================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ssb-nextgen-pro

# ===========================================
# Feature Flags
# ===========================================
ENABLE_WAF=true
ENABLE_RATE_LIMITING=true
ENABLE_AUTH=false