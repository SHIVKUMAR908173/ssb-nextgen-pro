    "scoring_dimensions": {
      "theme_quality": {
        "weight": 0.3,
        "description": "Relevance, depth, and positivity of themes expressed"
      },
      "protagonist_portrayal": {
        "weight": 0.25,
        "description": "How the protagonist is characterized and their actions"
      },
      "outcome_orientation": {
        "weight": 0.25,
        "description": "Whether the story leads to positive or negative outcomes"
      },
      "olq_alignment": {
        "weight": 0.2,
        "description": "Alignment with Officer Like Qualities"
      }
    }
  }
