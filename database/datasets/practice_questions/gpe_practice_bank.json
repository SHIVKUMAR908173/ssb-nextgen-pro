      "Leadership qualities",
      "Social awareness",
      "Innovative thinking",
      "Ethical considerations"
    ],
    "negative_indicators": [
      "Poor prioritization",
      "Resource wastage",
      "Impractical solutions",
      "Individual approach",
      "No backup plans",
      "Time mismanagement",
      "Lack of coordination",
