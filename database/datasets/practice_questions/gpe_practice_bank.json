  "evaluation_criteria": {
    "planning_aspects": {
      "problem_identification": {
        "weight": 0.2,
        "description": "Ability to identify all problems and priorities"
      },
      "resource_allocation": {
        "weight": 0.25,
        "description": "Efficient and logical use of available resources"
      },
      "solution_quality": {
        "weight": 0.25,
        "description": "Practicality and effectiveness of solutions"
      },
      "group_coordination": {
        "weight": 0.15,
        "description": "Ability to coordinate with group members"
      },
      "time_management": {
        "weight": 0.15,
        "description": "Proper sequencing and time allocation"
      }
    },
    "positive_indicators": [
      "Clear prioritization",
      "Efficient resource use",
